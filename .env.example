# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listener port (defaults to 3000)
PORT="3000"

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV="development"

# JWT_SECRET: Secret key for signing and verifying staff session tokens
JWT_SECRET="replace-with-a-secure-random-secret-in-production"

# NOTIFICATION_EMAIL: Internal inbox receiving real-time proposal alerts
NOTIFICATION_EMAIL="info@wanderersjourneys.com"

# CORS_ORIGIN: Allowed origins for cross-origin API requests (defaults to *)
CORS_ORIGIN="*"

# DATABASE_URL: Optional PostgreSQL connection URI when deploying to Neon, Supabase or Cloud SQL
# e.g., postgresql://user:password@host:5432/wanderers_db?sslmode=require
DATABASE_URL=""
